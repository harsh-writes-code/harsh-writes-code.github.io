---
type Props = {
  text: string
  icon: string
  href: string
}

const { text, icon, href } = Astro.props
---

<a href={href} target="_blank" class="w-fit px-3 py-1.5 group rounded-full border flex gap-2 items-center border-black/10 dark:border-white/15 hover:border-black/30 hover:dark:border-white/30 blend">
  <svg height={16} width={16} class="opacity-70 group-hover:opacity-100 blend">
    <use href={`/stack.svg?v=2#${icon}`}></use>
  </svg>
  <span class="text-sm text-black/55 dark:text-white/55 group-hover:text-black group-hover:dark:text-white blend">
    {text}
  </span>
</a>