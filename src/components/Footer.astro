---
import { SITE, SOCIALS } from "@consts"
import Container from "@components/Container.astro"
---

<footer class="relative bg-white dark:bg-black" transition:persist>
  <div class="animate">
    <section class="relative py-16 border-t border-black/10 dark:border-white/10">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-2/3 max-w-md h-px glow-line"></div>
      <Container size="xl">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-8">
          <div>
            <a href="/" class="flex gap-1.5 items-center w-fit font-bold tracking-tight text-lg text-current hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out">
              <svg class="size-5 fill-current">
                <use href="/brand.svg?v=2#brand"/>
              </svg>
              {SITE.TITLE}
            </a>
            <div class="flex items-center gap-2 mt-3 text-sm">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-black/40 dark:bg-white/40"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-black dark:bg-white"></span>
              </span>
              Open to new opportunities
            </div>
          </div>

          <button id="back-to-top" aria-label="Back to top of page" class="group flex w-fit gap-1.5 text-sm font-semibold items-center text-black/50 dark:text-white/50 hover:text-black hover:dark:text-white transition-colors duration-300 ease-in-out">
            Back to top
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:-translate-y-1 blend">
              <line x1="12" y1="19" x2="12" y2="5" />
              <polyline points="5 12 12 5 19 12" />
            </svg>
          </button>
        </div>
      </Container>
    </section>

    <section class="py-6 border-t border-black/10 dark:border-white/10">
      <Container size="xl">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-sm">
          <div class="order-2 sm:order-1 flex items-center gap-3">
            <a href="/legal/terms" class="text-current hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out">
              Terms
            </a>
            <span class="opacity-30">/</span>
            <a href="/legal/privacy" class="text-current hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out">
              Privacy
            </a>
            <span class="opacity-30">/</span>
            <span>&copy; 2026 {SITE.AUTHOR}</span>
          </div>

          <div class="order-1 sm:order-2 flex gap-4 items-center">
            {
              SOCIALS.map((SOCIAL) => (
                <a
                  href={SOCIAL.HREF}
                  target="_blank"
                  aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
                  class="group text-black/50 dark:text-white/50 hover:text-black hover:dark:text-white blend hover:-translate-y-0.5 inline-block"
                >
                  <svg class="size-4 fill-current blend group-hover:scale-110">
                    <use href={`/social.svg#${SOCIAL.ICON}`} />
                  </svg>
                </a>
              ))
            }
          </div>
        </div>
      </Container>
    </section>
  </div>

</footer>

<script is:inline>
  function goBackToTop(event) {
    event.preventDefault()
    window.scrollTo({
        top: 0,
        behavior: "smooth"
    })
  }

  function inintializeBackToTop() {
    const backToTop = document.getElementById("back-to-top")
    backToTop?.addEventListener("click", goBackToTop)
  }

  document.addEventListener("astro:after-swap", inintializeBackToTop)
  inintializeBackToTop()
</script>