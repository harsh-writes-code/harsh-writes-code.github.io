<div id="hero3d" class="relative w-full h-full pointer-events-none">
  <canvas id="hero3d-canvas" class="block w-full h-full"></canvas>
</div>

<script>
  import * as THREE from "three"

  const NODE_COUNT = 46
  const RADIUS = 1.8
  const NEIGHBORS_PER_NODE = 2

  function fibonacciSpherePoints(count: number, radius: number) {
    const points: THREE.Vector3[] = []
    const offset = 2 / count
    const increment = Math.PI * (3 - Math.sqrt(5))
    for (let i = 0; i < count; i++) {
      const y = i * offset - 1 + offset / 2
      const r = Math.sqrt(Math.max(0, 1 - y * y))
      const phi = i * increment
      const x = Math.cos(phi) * r
      const z = Math.sin(phi) * r
      const jitter = 0.85 + Math.random() * 0.3
      points.push(new THREE.Vector3(x, y, z).multiplyScalar(radius * jitter))
    }
    return points
  }

  function buildEdgePositions(points: THREE.Vector3[], neighborsPerNode: number) {
    const used = new Set<string>()
    const segmentPoints: THREE.Vector3[] = []
    for (let i = 0; i < points.length; i++) {
      const distances: [number, number][] = []
      for (let j = 0; j < points.length; j++) {
        if (i === j) continue
        distances.push([j, points[i].distanceToSquared(points[j])])
      }
      distances.sort((a, b) => a[1] - b[1])
      for (let k = 0; k < neighborsPerNode && k < distances.length; k++) {
        const j = distances[k][0]
        const key = i < j ? `${i}-${j}` : `${j}-${i}`
        if (used.has(key)) continue
        used.add(key)
        segmentPoints.push(points[i], points[j])
      }
    }
    return segmentPoints
  }

  function makeDotTexture() {
    const size = 64
    const canvas = document.createElement("canvas")
    canvas.width = size
    canvas.height = size
    const ctx = canvas.getContext("2d")
    if (!ctx) return null
    const gradient = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2)
    gradient.addColorStop(0, "rgba(255,255,255,1)")
    gradient.addColorStop(0.5, "rgba(255,255,255,0.55)")
    gradient.addColorStop(1, "rgba(255,255,255,0)")
    ctx.fillStyle = gradient
    ctx.fillRect(0, 0, size, size)
    const texture = new THREE.CanvasTexture(canvas)
    texture.needsUpdate = true
    return texture
  }

  function initHero3D() {
    const container = document.getElementById("hero3d")
    const canvas = document.getElementById("hero3d-canvas")
    if (!(container instanceof HTMLElement) || !(canvas instanceof HTMLCanvasElement)) return

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

    const scene = new THREE.Scene()
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100)
    camera.position.set(0, 0, 6.2)

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true })
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))

    function isDark() {
      return document.documentElement.classList.contains("dark")
    }

    function getColor() {
      return isDark() ? 0xffffff : 0x111111
    }

    function getFogColor() {
      return isDark() ? 0x000000 : 0xffffff
    }

    const fog = new THREE.Fog(getFogColor(), 3.4, 9)
    scene.fog = fog

    const group = new THREE.Group()
    scene.add(group)

    const points = fibonacciSpherePoints(NODE_COUNT, RADIUS)

    const nodeGeometry = new THREE.BufferGeometry().setFromPoints(points)
    const dotTexture = makeDotTexture()
    const nodeMaterial = new THREE.PointsMaterial({
      color: getColor(),
      size: 0.16,
      map: dotTexture || undefined,
      transparent: true,
      opacity: 0.95,
      sizeAttenuation: true,
      depthWrite: false,
      fog: true,
    })
    const nodePoints = new THREE.Points(nodeGeometry, nodeMaterial)
    group.add(nodePoints)

    const edgeSegments = buildEdgePositions(points, NEIGHBORS_PER_NODE)
    const edgeGeometry = new THREE.BufferGeometry().setFromPoints(edgeSegments)
    const edgeMaterial = new THREE.LineBasicMaterial({
      color: getColor(),
      transparent: true,
      opacity: 0.28,
      fog: true,
    })
    const edgeLines = new THREE.LineSegments(edgeGeometry, edgeMaterial)
    group.add(edgeLines)

    function render() {
      renderer.render(scene, camera)
    }

    function resize() {
      const { width, height } = container.getBoundingClientRect()
      if (width === 0 || height === 0) return
      renderer.setSize(width, height, false)
      camera.aspect = width / height
      camera.updateProjectionMatrix()
      render()
    }

    const ro = new ResizeObserver(resize)
    ro.observe(container)
    resize()

    let pointerX = 0
    let pointerY = 0
    function onPointerMove(e: PointerEvent) {
      const rect = container.getBoundingClientRect()
      pointerX = ((e.clientX - rect.left) / rect.width) * 2 - 1
      pointerY = ((e.clientY - rect.top) / rect.height) * 2 - 1
    }
    window.addEventListener("pointermove", onPointerMove)

    const themeObserver = new MutationObserver(() => {
      const color = getColor()
      nodeMaterial.color.setHex(color)
      edgeMaterial.color.setHex(color)
      fog.color.setHex(getFogColor())
      if (reduceMotion) render()
    })
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] })

    if (reduceMotion) {
      group.rotation.set(0.35, 0.5, 0)
      render()
      return
    }

    const clock = new THREE.Clock()
    function animate() {
      const t = clock.getElapsedTime()
      group.rotation.y = t * 0.18 + pointerX * 0.35
      group.rotation.x = Math.sin(t * 0.25) * 0.12 + pointerY * 0.25
      render()
      requestAnimationFrame(animate)
    }
    animate()
  }

  document.addEventListener("astro:after-swap", initHero3D)
  initHero3D()
</script>
