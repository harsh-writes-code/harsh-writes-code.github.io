<div id="hero3d" class="relative w-full h-full pointer-events-none">
  <canvas id="hero3d-canvas" class="block w-full h-full"></canvas>
</div>

<script>
  import * as THREE from "three"

  function initHero3D() {
    const container = document.getElementById("hero3d")
    const canvas = document.getElementById("hero3d-canvas")
    if (!(container instanceof HTMLElement) || !(canvas instanceof HTMLCanvasElement)) return

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

    const scene = new THREE.Scene()
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100)
    camera.position.set(0, 0, 6)

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true })
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))

    function getLineColor() {
      return document.documentElement.classList.contains("dark") ? 0xffffff : 0x111111
    }

    // Outer faceted shape (edges only, no fill)
    const outerGeo = new THREE.IcosahedronGeometry(1.8, 1)
    const outerEdges = new THREE.EdgesGeometry(outerGeo)
    const outerMat = new THREE.LineBasicMaterial({ color: getLineColor(), transparent: true, opacity: 0.9 })
    const outerLines = new THREE.LineSegments(outerEdges, outerMat)
    scene.add(outerLines)

    // Smaller inner shape, counter-rotating, fainter — gives it depth
    const innerGeo = new THREE.IcosahedronGeometry(1.05, 0)
    const innerEdges = new THREE.EdgesGeometry(innerGeo)
    const innerMat = new THREE.LineBasicMaterial({ color: getLineColor(), transparent: true, opacity: 0.35 })
    const innerLines = new THREE.LineSegments(innerEdges, innerMat)
    scene.add(innerLines)

    function render() {
      renderer.render(scene, camera)
    }

    function resize() {
      const { width, height } = container.getBoundingClientRect()
      if (width === 0 || height === 0) return
      renderer.setSize(width, height, false)
      camera.aspect = width / height
      camera.updateProjectionMatrix()
      render()
    }

    const ro = new ResizeObserver(resize)
    ro.observe(container)
    resize()

    // Subtle pointer-follow offset on top of the idle spin
    let pointerX = 0
    let pointerY = 0
    function onPointerMove(e: PointerEvent) {
      const rect = container.getBoundingClientRect()
      pointerX = ((e.clientX - rect.left) / rect.width) * 2 - 1
      pointerY = ((e.clientY - rect.top) / rect.height) * 2 - 1
    }
    window.addEventListener("pointermove", onPointerMove)

    // Keep line color in sync with the light/dark toggle
    const themeObserver = new MutationObserver(() => {
      const color = getLineColor()
      outerMat.color.setHex(color)
      innerMat.color.setHex(color)
      if (reduceMotion) render()
    })
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] })

    if (reduceMotion) {
      outerLines.rotation.set(0.4, 0.6, 0)
      innerLines.rotation.set(-0.3, -0.5, 0)
      render()
      return
    }

    const clock = new THREE.Clock()
    function animate() {
      const t = clock.getElapsedTime()
      outerLines.rotation.x = t * 0.15 + pointerY * 0.3
      outerLines.rotation.y = t * 0.2 + pointerX * 0.3
      innerLines.rotation.x = -t * 0.1 - pointerY * 0.2
      innerLines.rotation.y = -t * 0.12 - pointerX * 0.2
      render()
      requestAnimationFrame(animate)
    }
    animate()
  }

  document.addEventListener("astro:after-swap", initHero3D)
  initHero3D()
</script>
