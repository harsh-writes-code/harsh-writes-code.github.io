<script>
  import Lenis from "lenis"
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  let lenis: Lenis | undefined

  function initSmoothScroll() {
    if (lenis || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
    lenis = new Lenis({ duration: 1.1, smoothWheel: true })
    lenis.on("scroll", ScrollTrigger.update)
    gsap.ticker.add((time) => {
      lenis?.raf(time * 1000)
    })
    gsap.ticker.lagSmoothing(0)
  }

  function splitHeroLines() {
    const lines = document.querySelectorAll<HTMLElement>(".split-line")
    if (!lines.length) return
    gsap.set(lines, { yPercent: 110, opacity: 0 })
    gsap.to(lines, {
      yPercent: 0,
      opacity: 1,
      duration: 1,
      ease: "power3.out",
      stagger: 0.12,
      delay: 0.15,
    })
  }

  function animateCounters() {
    const nums = document.querySelectorAll<HTMLElement>(".stat-number")
    nums.forEach((el) => {
      const raw = el.textContent || ""
      const match = raw.match(/\d+/)
      if (!match) return
      const target = parseInt(match[0], 10)
      const suffix = raw.slice(match[0].length)
      const counter = { val: 0 }
      gsap.to(counter, {
        val: target,
        duration: 1.3,
        ease: "power2.out",
        delay: 0.4,
        onUpdate: () => {
          el.textContent = Math.round(counter.val) + suffix
        },
      })
    })
  }

  function animateTimeline() {
    const rail = document.querySelector<HTMLElement>(".timeline-rail")
    const list = document.querySelector<HTMLElement>("#about ul")
    const dots = document.querySelectorAll<HTMLElement>(".timeline-dot")
    if (!rail || !list) return

    gsap.set(rail, { scaleY: 0, transformOrigin: "top" })
    gsap.to(rail, {
      scaleY: 1,
      ease: "none",
      scrollTrigger: {
        trigger: list,
        start: "top 70%",
        end: "bottom 60%",
        scrub: 0.6,
      },
    })

    if (dots.length) {
      gsap.set(dots, { scale: 0 })
      dots.forEach((dot) => {
        gsap.to(dot, {
          scale: 1,
          duration: 0.5,
          ease: "back.out(2)",
          scrollTrigger: {
            trigger: dot,
            start: "top 82%",
          },
        })
      })
    }
  }

  function animateWorkRows() {
    const rows = document.querySelectorAll<HTMLElement>("#work li")
    if (!rows.length) return
    gsap.set(rows, { opacity: 0, y: 24 })
    gsap.to(rows, {
      opacity: 1,
      y: 0,
      duration: 0.7,
      ease: "power3.out",
      stagger: 0.08,
      scrollTrigger: {
        trigger: "#work ul",
        start: "top 80%",
      },
    })
  }

  function initMotion() {
    ScrollTrigger.getAll().forEach((t) => t.kill())
    initSmoothScroll()
    splitHeroLines()
    animateCounters()
    animateTimeline()
    animateWorkRows()
    requestAnimationFrame(() => ScrollTrigger.refresh())
  }

  document.addEventListener("astro:after-swap", initMotion)
  initMotion()
</script>
