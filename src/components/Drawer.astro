---
import { SITE, LINKS } from "@consts"
import { cn } from "@lib/utils"
const { pathname } = Astro.url
const subpath = pathname.match(/[^/]+/g)
---

<div id="drawer" class="fixed inset-0 z-40 overflow-hidden flex flex-col items-center justify-center md:hidden bg-white/95 dark:bg-black/95 backdrop-blur-xl">
  <nav class="flex flex-col items-center gap-6">
    {
      LINKS.map((LINK, i) => (
        <a data-index={i} href={LINK.HREF} class={cn("drawer-link text-2xl font-bold tracking-tight", "text-current hover:text-black dark:hover:text-white", "transition-colors duration-300 ease-in-out", pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF ? "text-black dark:text-white" : "")}>
          {LINK.TEXT}
        </a>
      ))
    }
  </nav>

  <div class="drawer-link flex gap-2 mt-10">
    <a href="/search" aria-label={`Search projects on ${SITE.TITLE}`} class={cn("size-10 rounded-full p-2 items-center justify-center bg-transparent hover:bg-black/5 dark:hover:bg-white/10 stroke-current hover:stroke-black hover:dark:stroke-white border border-black/10 dark:border-white/15 transition-colors duration-300 ease-in-out", pathname === "/search" || "/" + subpath?.[0] === "search" ? "pointer-events-none bg-black dark:bg-white text-white dark:text-black" : "")}>
      <svg class="size-full">
        <use href="/ui.svg#search"></use>
      </svg>
    </a>



    <button id="drawer-theme-button" aria-label={`Toggle light and dark theme`} class="size-10 rounded-full p-2 items-center justify-center bg-transparent hover:bg-black/5 dark:hover:bg-white/10 stroke-current hover:stroke-black hover:dark:stroke-white border border-black/10 dark:border-white/15 transition-colors duration-300 ease-in-out">
      <svg class="block dark:hidden size-full">
        <use href="/ui.svg#sun"></use>
      </svg>
      <svg class="hidden dark:block size-full">
        <use href="/ui.svg#moon"></use>
      </svg>
    </button>
  </div>
</div>

<style>
  #drawer {
    clip-path: circle(0% at calc(100% - 2.75rem) 2.75rem);
    pointer-events: none;
    transition: clip-path 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #drawer.open {
    clip-path: circle(150% at calc(100% - 2.75rem) 2.75rem);
    pointer-events: auto;
  }

  #drawer .drawer-link {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  #drawer.open .drawer-link {
    opacity: 1;
    transform: translateY(0);
  }

  #drawer.open .drawer-link:nth-child(1) { transition-delay: 0.1s; }
  #drawer.open .drawer-link:nth-child(2) { transition-delay: 0.16s; }
  #drawer.open .drawer-link:nth-child(3) { transition-delay: 0.22s; }
  #drawer.open .drawer-link:nth-child(4) { transition-delay: 0.28s; }

  @media (prefers-reduced-motion: reduce) {
    #drawer,
    #drawer .drawer-link {
      transition: opacity 0.2s ease;
    }
  }
</style>