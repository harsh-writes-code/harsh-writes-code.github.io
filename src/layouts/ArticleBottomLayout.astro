---
import { type CollectionEntry, getCollection, render } from "astro:content"

type Props = {
  entry: CollectionEntry<"projects">
}

// Get the requested entry
const { entry } = Astro.props
const { collection } = entry
const { Content } = await render(entry)

// Get the next and prev entries (modulo to wrap index)
const items = (await getCollection(collection))
  .filter(post => !post.data.draft)
  .sort((a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0))
const index = items.findIndex(x => x.id === entry.id)
const prev = items[(index - 1 + items.length) % items.length]
const next = items[(index + 1) % items.length]
---

<div>
  <article>
    <Content/>
  </article>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-10 mt-10 border-t border-black/10 dark:border-white/10">
    <a href={`/${prev.collection}/${prev.id}`} class="group flex items-center gap-3 blend">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 stroke-current opacity-40 group-hover:opacity-100 group-hover:stroke-black group-hover:dark:stroke-white group-hover:-translate-x-1 blend">
        <line x1="19" y1="12" x2="5" y2="12" />
        <polyline points="12 19 5 12 12 5" />
      </svg>
      <div>
        <div class="eyebrow">Prev</div>
        <div class="font-bold mt-1 text-black dark:text-white">
          {prev.data.title}
        </div>
      </div>
    </a>
    <a href={`/${next.collection}/${next.id}`} class="group flex items-center justify-end text-right gap-3 blend">
      <div>
        <div class="eyebrow">Next</div>
        <div class="font-bold mt-1 text-black dark:text-white">
          {next.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 stroke-current opacity-40 group-hover:opacity-100 group-hover:stroke-black group-hover:dark:stroke-white group-hover:translate-x-1 blend">
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="12 5 19 12 12 19" />
      </svg>
    </a>
  </div>
</div>
