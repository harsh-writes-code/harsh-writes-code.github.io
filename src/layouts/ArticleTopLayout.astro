---
import type { CollectionEntry } from "astro:content"
import { formatDate, readingTime } from "@lib/utils"

type Props = {
  entry: CollectionEntry<"projects">
}

const { entry } = Astro.props
const { collection, data, body } = entry
const { title, summary, date } = data

const demoUrl = collection === "projects" ? data.demoUrl : null
const repoUrl = collection === "projects" ? data.repoUrl : null
---

<div>
  <a href={`/${collection}`} class="group w-fit gap-1.5 text-sm font-semibold flex items-center text-black/50 dark:text-white/50 hover:text-black hover:dark:text-white transition-colors duration-300 ease-in-out">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:-translate-x-1 blend">
      <line x1="19" y1="12" x2="5" y2="12" />
      <polyline points="12 19 5 12 12 5" />
    </svg>
    <div>
      Back to {collection}
    </div>
  </a>
  <div class="flex flex-wrap eyebrow mt-10 gap-4">
    <div class="flex items-center gap-1.5">
      <svg class="size-4 stroke-current">
        <use href="/ui.svg#calendar"/>
      </svg>
      {formatDate(date)}
    </div>
    <div class="flex items-center gap-1.5">
      <svg class="size-4 stroke-current">
        <use href="/ui.svg#book-open"/>
      </svg>
      {readingTime(body || '')}
    </div>
  </div>
  <div class="relative">
    <div class="absolute -left-10 -top-10 w-72 h-40 glow-accent blur-3xl opacity-40 dark:opacity-30 -z-10"></div>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-black dark:text-white mt-3">
      {title}
    </h1>
  </div>
  <div class="mt-3 text-lg max-w-2xl">
    {summary}
  </div>
  {(demoUrl || repoUrl) &&
  <div class="mt-6 flex flex-wrap gap-3">
    {demoUrl &&
      <a href={demoUrl} target="_blank" class="group flex gap-2 items-center text-sm font-semibold text-black dark:text-white">
        <svg class="size-4">
          <use href="/ui.svg#globe" class="fill-current blend"/>
        </svg>
        <span class="border-b border-black/30 dark:border-white/30 group-hover:border-black group-hover:dark:border-white blend">
          See demo
        </span>
      </a>
    }
    {repoUrl &&
      <a href={repoUrl} target="_blank" class="group flex gap-2 items-center text-sm font-semibold text-black dark:text-white">
        <svg class="size-4">
          <use href="/ui.svg#link" class="fill-current blend"/>
        </svg>
        <span class="border-b border-black/30 dark:border-white/30 group-hover:border-black group-hover:dark:border-white blend">
          See repository
        </span>
      </a>
    }
  </div>
  }
</div>
