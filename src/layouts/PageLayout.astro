---
import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import Drawer from "@components/Drawer.astro"
const { title, description } = Astro.props
import { SITE } from "@consts"
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${title} | ${SITE.TITLE}`} description={description} />
  </head>
  <body>
    <!-- Ambient background: faint grid + soft glow, same in both themes -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="ambient-grid absolute inset-0"></div>
      <div class="absolute -top-40 right-[-10%] w-[36rem] h-[36rem] rounded-full bg-black/[0.04] dark:bg-white/[0.05] blur-3xl"></div>
      <div class="absolute top-[60%] -left-40 w-[30rem] h-[30rem] rounded-full bg-black/[0.03] dark:bg-white/[0.04] blur-3xl"></div>
    </div>

    <Header />
    <Drawer />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
