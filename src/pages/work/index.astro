---
import { getCollection, render } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { WORK } from "@consts"

const collection = await getCollection("work")

collection.sort((a, b) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime())

const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await render(item)
    return { ...item, Content }
  })
)

function formatWorkDate(input: Date | string) {
  if (typeof input === "string") return input

  const month = input.toLocaleDateString("en-US", {
    month: "short",
  })

  const year = new Date(input).getFullYear()
  return `${month} ${year}`
}
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <TopLayout>
    <div class="animate">
      <div class="eyebrow mb-3">Experience</div>
      <div class="page-heading">
        {WORK.TITLE}
      </div>
      <p class="mt-3 text-lg max-w-xl">
        {WORK.DESCRIPTION}
      </p>
    </div>
  </TopLayout>
  <BottomLayout>
    <ul class="relative">
      <div class="absolute left-[7px] sm:left-[159px] top-2 bottom-2 w-px bg-gradient-to-b from-transparent via-black/15 dark:via-white/15 to-transparent"></div>
      {
        work.map((entry, i) => (
          <li class={`${i % 2 === 0 ? "reveal-left" : "reveal-right"} relative pl-8 sm:pl-0 py-8 first-of-type:pt-0`}>
            <div class="absolute left-0 sm:left-[152px] top-9 sm:top-10 size-[15px] rounded-full bg-white dark:bg-black border-2 border-black dark:border-white shadow-[0_0_0_4px_rgb(var(--accent)/0.2)]" />
            <div class="grid grid-cols-1 sm:grid-cols-[160px_1fr] gap-3 sm:gap-8">
              <div class="eyebrow sm:pt-8">
                {formatWorkDate(entry.data.dateStart)} — {formatWorkDate(entry.data.dateEnd)}
              </div>
              <div data-tilt class="card-3d glass rounded-2xl p-6 sm:p-8">
                <div class="text-black dark:text-white font-bold text-xl">
                  {entry.data.company}
                </div>
                <div class="text-sm font-semibold uppercase tracking-wide text-black/50 dark:text-white/50 mt-1">
                  {entry.data.role}
                </div>
                <article class="prose dark:prose-invert mt-4">
                  <entry.Content />
                </article>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </BottomLayout>
</PageLayout>
