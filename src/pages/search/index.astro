---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import Search from "@components/Search"
import { SEARCH } from "@consts"

const projects = (await getCollection("projects"))
  .filter(post => !post.data.draft)

const data = [...projects] as CollectionEntry<"projects">[]
---

<PageLayout title={SEARCH.TITLE} description={SEARCH.DESCRIPTION}>
  <TopLayout>
    <div class="animate">
      <div class="eyebrow mb-3">Find something</div>
      <div class="page-heading">
        {SEARCH.TITLE}
      </div>
      <p class="mt-3 text-lg max-w-xl">
        {SEARCH.DESCRIPTION}
      </p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Search client:load data={data}/>
    </div>
  </BottomLayout>
</PageLayout>