---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import ArrowCard from "@components/ArrowCard"
import StackCard from "@components/StackCard.astro"
import { SITE, SOCIALS } from "@consts"

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0))
  .slice(0,3)

const stack = [
  {
    text: "Node.js",
    icon: "javascript",
    href: "https://nodejs.org"
  },
  {
    text: "TypeScript",
    icon: "typescript",
    href: "https://www.typescriptlang.org"
  },
  {
    text: "PHP",
    icon: "php",
    href: "https://www.php.net/"
  },
  {
    text: "Laravel",
    icon: "laravel",
    href: "https://laravel.com/"
  },
  {
    text: "CodeIgniter",
    icon: "codeigniter",
    href: "https://codeigniter.com/"
  },
  {
    text: "AWS",
    icon: "aws",
    href: "https://aws.amazon.com/"
  },
  {
    text: "MySQL",
    icon: "database",
    href: "https://www.mysql.com/"
  },
]
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>

  <!-- HERO -->
  <section id="hero" class="relative pt-40 sm:pt-48 pb-20">
    <Container size="xl">
      <div class="animate max-w-3xl" style="perspective: 1200px;">
        <div id="hero-tilt" class="[transform-style:preserve-3d] will-change-transform">
          <div class="eyebrow mb-6 flex items-center gap-2" style="transform: translateZ(24px);">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-black/40 dark:bg-white/40"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-black dark:bg-white"></span>
            </span>
            Backend Software Engineer
          </div>
          <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold tracking-tight text-black dark:text-white" style="transform: translateZ(48px);">
            {SITE.AUTHOR}
          </h1>
          <p class="mt-6 text-lg sm:text-xl leading-relaxed max-w-2xl" style="transform: translateZ(16px);">
            {SITE.DESCRIPTION}
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-4" style="transform: translateZ(32px);">
            <a href="/work" class="py-3 px-6 text-sm font-semibold bg-black dark:bg-white text-white dark:text-black hover:bg-black/80 hover:dark:bg-white/80 transition-colors">
              View my work
            </a>
            <a href="/projects" class="group flex gap-1.5 items-center text-sm font-semibold text-black dark:text-white">
              Explore projects
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:translate-x-1 blend">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
            <a href="/Harsh_Resume.pdf" target="_blank" class="group flex gap-1.5 items-center text-sm font-semibold text-black/60 dark:text-white/60 hover:text-black hover:dark:text-white blend">
              <svg class="size-4 fill-current" viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
              Resume
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Container size="xl">

    <!-- ABOUT -->
    <section class="animate grid grid-cols-1 md:grid-cols-[140px_1fr] gap-4 md:gap-12 py-16 border-t border-black/10 dark:border-white/10">
      <div class="eyebrow md:pt-1">01 — About</div>
      <div class="max-w-2xl space-y-5 text-lg leading-relaxed">
        <p>I'm a <span class="text-black dark:text-white font-semibold">backend developer</span> with 1+ years of experience designing and building scalable web applications.</p>
        <p>I'm passionate about writing clean, maintainable code and developing enterprise-level backend solutions. My core expertise lies in Node.js, Express.js, TypeScript, PHP (Laravel), MySQL, Sequelize ORM, Redis, and AWS.</p>
        <p>I've built secure REST APIs, designed robust database schemas, implemented authentication systems, integrated cloud storage, and optimized performance for high-traffic applications.</p>
        <p>Currently I work as a Software Engineer (Backend Developer) at <span class="text-black dark:text-white font-semibold">Omega Broadcast Pvt. Ltd.</span>, building scalable REST APIs and modular backend architectures.</p>
      </div>
    </section>

    <!-- STACK -->
    <section class="animate grid grid-cols-1 md:grid-cols-[140px_1fr] gap-4 md:gap-12 py-16 border-t border-black/10 dark:border-white/10">
      <div class="eyebrow md:pt-1">02 — Stack</div>
      <div class="flex flex-wrap items-center gap-2.5">
        {stack.map(item => (
          <StackCard
            text={item.text}
            icon={item.icon}
            href={item.href}
          />
        ))}
      </div>
    </section>

    <!-- SELECTED WORK -->
    <section class="animate grid grid-cols-1 md:grid-cols-[140px_1fr] gap-4 md:gap-12 py-16 border-t border-black/10 dark:border-white/10">
      <div class="eyebrow md:pt-1">03 — Selected work</div>
      <div>
        <ul>
          {projects.map((project) => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
        <a href="/projects" class="group inline-flex gap-1.5 items-center mt-6 text-sm font-semibold text-black dark:text-white">
          All projects
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:translate-x-1 blend">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="animate grid grid-cols-1 md:grid-cols-[140px_1fr] gap-4 md:gap-12 py-16 border-t border-black/10 dark:border-white/10">
      <div class="eyebrow md:pt-1">04 — Contact</div>
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-black dark:text-white max-w-xl">
          Open to new opportunities and interesting backend problems.
        </h2>
        <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
          {SOCIALS.map(social => (
            <a href={social.HREF} target="_blank" class="group flex items-center gap-2 text-lg font-semibold text-black/70 dark:text-white/70 hover:text-black hover:dark:text-white blend">
              <svg class="size-5 fill-current opacity-60 group-hover:opacity-100 blend">
                <use href={`/social.svg#${social.ICON}`}></use>
              </svg>
              {social.TEXT}
            </a>
          ))}
        </div>
      </div>
    </section>

  </Container>
</PageLayout>

<script>
  function initHeroTilt() {
    const hero = document.getElementById("hero")
    const tilt = document.getElementById("hero-tilt")
    if (!hero || !tilt) return
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
    if (window.matchMedia("(pointer: coarse)").matches) return

    const maxDeg = 7
    let targetX = 0, targetY = 0, curX = 0, curY = 0
    let raf: number | null = null

    function animate() {
      curX += (targetX - curX) * 0.08
      curY += (targetY - curY) * 0.08
      tilt!.style.transform = `rotateX(${curX}deg) rotateY(${curY}deg)`
      if (Math.abs(targetX - curX) > 0.01 || Math.abs(targetY - curY) > 0.01) {
        raf = requestAnimationFrame(animate)
      } else {
        raf = null
      }
    }

    function onMove(e: MouseEvent) {
      const rect = hero!.getBoundingClientRect()
      const px = (e.clientX - rect.left) / rect.width
      const py = (e.clientY - rect.top) / rect.height
      targetY = (px - 0.5) * maxDeg * 2
      targetX = -(py - 0.5) * maxDeg * 2
      if (raf === null) raf = requestAnimationFrame(animate)
    }

    function onLeave() {
      targetX = 0
      targetY = 0
      if (raf === null) raf = requestAnimationFrame(animate)
    }

    hero.addEventListener("mousemove", onMove)
    hero.addEventListener("mouseleave", onLeave)
  }

  document.addEventListener("astro:after-swap", initHeroTilt)
  initHeroTilt()
</script>
